# ------------------------------------------------------------------------------
# DxClinic Baileys Development WhatsApp Gateway — Environment Template
# ------------------------------------------------------------------------------

# Network Binding (Loopback only for security)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=9090

# Shared Secret for HMAC-SHA256 Authentication (Must match BAILEYS_GATEWAY_SECRET in Laravel .env)
GATEWAY_SECRET=generate_a_secure_random_gateway_secret_minimum_32_chars

# Laravel Webhook Target & Webhook Signing Secret (Must match BAILEYS_WEBHOOK_SECRET in Laravel .env)
LARAVEL_WEBHOOK_URL=http://127.0.0.1:8088/api/internal/baileys/webhook
LARAVEL_WEBHOOK_SECRET=generate_a_secure_random_webhook_secret_minimum_32_chars

# Local Multi-Device Session Storage
SESSION_DIR=./sessions
LOG_LEVEL=info
QR_EXPIRY_SECONDS=300

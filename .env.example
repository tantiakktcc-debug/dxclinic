APP_NAME=DxClinic
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database Configuration (MySQL 8.0+ Required for Composite Integrity)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dxclinic
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------------------
# Cache, Session & Queue
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------------------
# Mail Configuration
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@dxclinic.local"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# DxClinic Domain & Clinical Practice Configuration
# ------------------------------------------------------------------------------
DXCLINIC_NAME="DxClinic Practice Suite"
DXCLINIC_TIMEZONE="Asia/Kolkata"
DXCLINIC_POLLING_INTERVAL=5
DXCLINIC_ONLINE_BOOKING=true
DXCLINIC_GRACE_DAYS=5
DXCLINIC_TOKEN_PAD_LENGTH=3

# AES-256 Encrypted Local Backup Passphrase (Minimum 6 characters)
BACKUP_PASSPHRASE="change_this_to_a_secure_backup_passphrase"

# Canonical Developer Attribution
DEVELOPER_WEBSITE="https://nexorasolutionsind.co.in/"
DEVELOPER_NAME="Kundan Kumar"
DEVELOPER_COMPANY="Nexora Solutions"
DEVELOPER_EMAIL="contact@nexorasolutionsind.co.in"
DEVELOPER_PHONE="+91 98765 43210"

# ------------------------------------------------------------------------------
# WhatsApp Omnichannel Configuration
# Options:
#   baileys → Development local transport via Node.js Baileys gateway (127.0.0.1:9090)
#   meta    → Production Meta Cloud API
#   mock    → Automated test runner
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER=baileys

# Meta Cloud API (Production)
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
WHATSAPP_META_LIVE_ENABLED=false
WHATSAPP_DEVELOPMENT_TEST_PHONE=
WHATSAPP_VERIFY_TOKEN=dxclinic_verify_token_secure
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_MAX_RETRIES=3
WHATSAPP_TIMEOUT=15

# Baileys Development Gateway (Local loopback transport)
BAILEYS_GATEWAY_URL="http://127.0.0.1:9090"
BAILEYS_GATEWAY_SECRET="generate_a_secure_random_gateway_secret_minimum_32_chars"
BAILEYS_WEBHOOK_SECRET="generate_a_secure_random_webhook_secret_minimum_32_chars"
BAILEYS_WEBHOOK_VERIFY_TOKEN="baileys_dev_verify_secure"
BAILEYS_GATEWAY_TIMEOUT=15

# Vite Asset Configuration
VITE_APP_NAME="${APP_NAME}"
